#version 450
// Temporal accumulation of the KPCN output, then raygen's remodulation and
// tonemap into outImage.
//
// The pixel's primary hit (ReSTIR reservoir hitWorld) is projected with last
// frame's camera to find where it was; history there is bilinear-fetched,
// each tap kept only if its stored eye distance matches (disocclusion test),
// clipped to the current 3x3 neighbourhood mean +- 1.25 sigma, then blended
// 90/10 with the current frame. History stores (rgb, distance to that
// frame's eye) as halves; sky pixels skip all of this.

layout(local_size_x = 16, local_size_y = 8) in;

layout(set = 0, binding = 1, rgba8) uniform readonly  image2D albedoImage;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D outImage;
layout(set = 0, binding = 3) readonly buffer Denoised { uvec2 denoised[]; };
layout(set = 0, binding = 6) uniform CameraUBO {
    vec4 eye_aspect;
    vec4 forward_fovTan;
    vec4 right_pad;
    vec4 up_pad;
    vec4 misc;
    vec4 prev_eye_aspect;
    vec4 prev_forward_fovTan;
    vec4 prev_right_pad;
    vec4 prev_up_pad;
} cam;
layout(set = 0, binding = 7) readonly buffer Reservoirs0 { int d[]; } resA;
layout(set = 0, binding = 8) readonly buffer Reservoirs1 { int d[]; } resB;
layout(set = 0, binding = 9) buffer History { uvec2 hist[]; };  // two halves, ping-pong

// wOff/bOff slots reused: which history half to read, and 1 to drop history.
layout(push_constant) uniform PC { ivec2 size; int histRead; int reset; } pc;

const float kAlpha = 0.1;
const float kClipSigma = 1.25;

vec3 fetchDenoised(ivec2 q)
{
    q = clamp(q, ivec2(0), pc.size - 1);
    uvec2 v = denoised[q.y * pc.size.x + q.x];
    return vec3(unpackHalf2x16(v.x), unpackHalf2x16(v.y).x);
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.size.x || p.y >= pc.size.y) return;

    const int  n        = pc.size.x * pc.size.y;
    const int  idx      = p.y * pc.size.x + p.x;
    const int  readBase = pc.histRead * n;
    const int  writeBase = (1 - pc.histRead) * n;
    const vec4 albedo   = imageLoad(albedoImage, p);
    const vec3 cur      = fetchDenoised(p);

    vec3  result = cur;
    float dist   = 0.0;
    if (albedo.a >= 0.5)
    {
        // closesthit writes this frame's reservoir to B on even frames.
        uint frameId = floatBitsToUint(cam.misc.x) & 0x3FFFFFFFu;
        int  b = idx * 12;
        vec3 world = (frameId & 1u) == 0u
            ? vec3(intBitsToFloat(resB.d[b + 8]), intBitsToFloat(resB.d[b + 9]), intBitsToFloat(resB.d[b + 10]))
            : vec3(intBitsToFloat(resA.d[b + 8]), intBitsToFloat(resA.d[b + 9]), intBitsToFloat(resA.d[b + 10]));
        dist = length(world - cam.eye_aspect.xyz);

        vec3  d     = world - cam.prev_eye_aspect.xyz;
        float z     = dot(d, cam.prev_forward_fovTan.xyz);
        float fov   = cam.prev_forward_fovTan.w;
        vec2  ndc   = vec2(dot(d, cam.prev_right_pad.xyz) / (z * fov * cam.prev_eye_aspect.w),
                           dot(d, cam.prev_up_pad.xyz)    / (z * fov));
        vec2  pp    = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5) * vec2(pc.size) - 0.5;
        float prevDist = length(d);

        vec3  hsum = vec3(0.0);
        float wsum = 0.0;
        if (pc.reset == 0 && z > 0.0)
        {
            ivec2 i0 = ivec2(floor(pp));
            vec2  f  = pp - vec2(i0);
            for (int k = 0; k < 4; ++k)
            {
                ivec2 q = i0 + ivec2(k & 1, k >> 1);
                if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, pc.size))) continue;
                uvec2 h = hist[readBase + q.y * pc.size.x + q.x];
                vec2  ba = unpackHalf2x16(h.y);
                if (abs(ba.y - prevDist) > 0.05 * prevDist) continue;
                float wk = ((k & 1) == 1 ? f.x : 1.0 - f.x) * ((k >> 1) == 1 ? f.y : 1.0 - f.y);
                hsum += wk * vec3(unpackHalf2x16(h.x), ba.x);
                wsum += wk;
            }
        }

        if (wsum > 1e-3)
        {
            vec3 m1 = vec3(0.0), m2 = vec3(0.0);
            for (int dy = -1; dy <= 1; ++dy)
            for (int dx = -1; dx <= 1; ++dx)
            {
                vec3 c = fetchDenoised(p + ivec2(dx, dy));
                m1 += c;
                m2 += c * c;
            }
            m1 /= 9.0;
            vec3 sigma = sqrt(max(m2 / 9.0 - m1 * m1, vec3(0.0)));
            vec3 h = clamp(hsum / wsum, m1 - kClipSigma * sigma, m1 + kClipSigma * sigma);
            result = mix(h, cur, kAlpha);
        }
    }
    hist[writeBase + idx] = uvec2(packHalf2x16(result.rg), packHalf2x16(vec2(result.b, dist)));

    vec3 final = albedo.a >= 0.5 ? result * albedo.rgb : result;
    float Y    = max(dot(final, vec3(0.299, 0.587, 0.114)), 1e-4);
    imageStore(outImage, p, vec4(min(final / (Y + 1.0), vec3(1.0)), 1.0));
}
