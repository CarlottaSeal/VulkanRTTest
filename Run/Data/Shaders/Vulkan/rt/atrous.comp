#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D inImage;
layout(set = 0, binding = 1, rgba16f) uniform image2D outImage;
layout(set = 0, binding = 2) buffer Reservoirs0 { int d[]; } resA;
layout(set = 0, binding = 3) buffer Reservoirs1 { int d[]; } resB;
layout(set = 0, binding = 4, rgba8)   uniform image2D albedoImage;

layout(push_constant) uniform PC {
    int  stride;
    uint frameId;
} pc;

vec3 readResNormal(uint pixIdx, bool fromA) {
    uint b = pixIdx * 12u;
    if (fromA)
        return vec3(intBitsToFloat(resA.d[b+4]),
                    intBitsToFloat(resA.d[b+5]),
                    intBitsToFloat(resA.d[b+6]));
    return vec3(intBitsToFloat(resB.d[b+4]),
                intBitsToFloat(resB.d[b+5]),
                intBitsToFloat(resB.d[b+6]));
}
float readResDepth(uint pixIdx, bool fromA) {
    uint b = pixIdx * 12u;
    return intBitsToFloat(fromA ? resA.d[b+7] : resB.d[b+7]);
}

void main()
{
    ivec2 px   = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inImage);
    if (px.x >= size.x || px.y >= size.y) return;

    // Sky pass-through.
    if (imageLoad(albedoImage, px).a < 0.5) {
        imageStore(outImage, px, imageLoad(inImage, px));
        return;
    }

    const bool readPongA = (pc.frameId & 1u) != 0u;
    const uint pixIdx = uint(px.y) * uint(size.x) + uint(px.x);
    const vec3  selfN = readResNormal(pixIdx, readPongA);
    const float selfD = readResDepth (pixIdx, readPongA);
    const vec4  selfRGBA = imageLoad(inImage, px);
    const vec3  selfC = selfRGBA.rgb;
    const float selfL = dot(selfC, vec3(0.299, 0.587, 0.114));
    const float selfV = selfRGBA.a;
    // Chromaticity (color normalized by luminance) — edge stop on this
    // preserves palette tints across the spatial filter. ReSTIR DI picks
    // one colored point light per pixel, so neighbors at similar luminance
    // but different hue must NOT merge or all colored regions average to
    // grey. Standard SVGF skips this because it assumes diffuse light is
    // smooth in color after albedo demodulation.
    const vec3 selfChrom = selfC / max(selfL, 0.01);

    // Adaptive luminance sigma. Floor at 0.08 — even with SVGF variance,
    // there's irreducible per-frame jitter (RIS pick, spatial taps, shadow
    // re-trace) that needs SOME baseline smoothing to not show up as moire
    // between adjacent pixels with slightly different variance estimates.
    const float sigmaL = clamp(sqrt(max(selfV, 1e-6)) * 4.0 + 0.08, 0.08, 0.4);

    // SVGF / A-Trous wavelet kernel: 5x5 with B3-spline (1,4,6,4,1)/16
    // outer-product weights. Center pixel weighs more than far ones, so
    // flat regions smooth harder; edge stops still cut off across
    // silhouettes. Reach is extended by multi-pass strides, not by a
    // wider kernel.
    const float kB3[5] = float[5](1.0/16.0, 4.0/16.0, 6.0/16.0, 4.0/16.0, 1.0/16.0);

    vec3  sumC = vec3(0.0);
    float sumV = 0.0;
    float wsum = 0.0;
    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            ivec2 npx = px + ivec2(dx, dy) * pc.stride;
            if (npx.x < 0 || npx.y < 0 || npx.x >= size.x || npx.y >= size.y) continue;
            uint  nIdx = uint(npx.y) * uint(size.x) + uint(npx.x);
            vec3  nN   = readResNormal(nIdx, readPongA);
            float nD   = readResDepth (nIdx, readPongA);
            vec4  nRGBA = imageLoad(inImage, npx);
            vec3  nC   = nRGBA.rgb;
            float nL   = dot(nC, vec3(0.299, 0.587, 0.114));
            float nV   = nRGBA.a;

            float kernelW = kB3[dx + 2] * kB3[dy + 2];
            vec3  nChrom  = nC / max(nL, 0.01);
            float wN = pow(max(dot(selfN, nN), 0.0), 8.0);
            float wD = exp(-abs(selfD - nD) / max(selfD, 0.01) * 8.0);
            float wL = exp(-abs(selfL - nL) / sigmaL);
            // sigma 0.4 — chromaticity is roughly a vec3 of normalized
            // components, so length differences ~0.3 mean strong hue
            // separation (red palette vs green palette).
            float wC = exp(-length(selfChrom - nChrom) / 0.4);
            float w  = (dx == 0 && dy == 0) ? kernelW
                                            : (kernelW * wN * wD * wL * wC);

            sumC += w * nC;
            sumV += w * w * nV;     // variance reduces by w² under weighted avg
            wsum += w;
        }
    }

    vec3  filteredC = (wsum > 0.0) ? (sumC / wsum)        : selfC;
    float filteredV = (wsum > 0.0) ? (sumV / (wsum*wsum)) : selfV;
    imageStore(outImage, px, vec4(filteredC, filteredV));
}
