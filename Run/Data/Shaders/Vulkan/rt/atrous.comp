#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D inImage;
layout(set = 0, binding = 1, rgba16f) uniform image2D outImage;
layout(set = 0, binding = 2) buffer Reservoirs0 { int d[]; } resA;
layout(set = 0, binding = 3) buffer Reservoirs1 { int d[]; } resB;
layout(set = 0, binding = 4, rgba8)   uniform image2D albedoImage;

layout(push_constant) uniform PC {
    int  stride;
    uint frameId;
} pc;

vec3 readResNormal(uint pixIdx, bool fromA) {
    uint b = pixIdx * 12u;
    if (fromA)
        return vec3(intBitsToFloat(resA.d[b+4]),
                    intBitsToFloat(resA.d[b+5]),
                    intBitsToFloat(resA.d[b+6]));
    return vec3(intBitsToFloat(resB.d[b+4]),
                intBitsToFloat(resB.d[b+5]),
                intBitsToFloat(resB.d[b+6]));
}
float readResDepth(uint pixIdx, bool fromA) {
    uint b = pixIdx * 12u;
    return intBitsToFloat(fromA ? resA.d[b+7] : resB.d[b+7]);
}

// 12x12 shared tile for stride=1 — replaces 1600 SSBO fetches per workgroup
// with 144 cooperative loads. Higher strides skip this (tile blows past 48KB).
const int  TILE_DIM = 12;
shared vec4 sND[TILE_DIM * TILE_DIM];

void main()
{
    ivec2 px   = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inImage);
    const bool readPongA = (pc.frameId & 1u) != 0u;
    const bool useSharedMem = (pc.stride == 1);

    // Populate shared mem before any early-out path so all threads hit
    // the barrier.
    if (useSharedMem) {
        ivec2 tileOrigin = ivec2(gl_WorkGroupID.xy) * 8 - 2;
        uint  tid        = gl_LocalInvocationIndex;
        for (uint i = tid; i < uint(TILE_DIM * TILE_DIM); i += 64u) {
            ivec2 lp = ivec2(int(i) % TILE_DIM, int(i) / TILE_DIM);
            ivec2 gp = tileOrigin + lp;
            vec3  n  = vec3(0.0);
            float d  = 0.0;
            if (gp.x >= 0 && gp.y >= 0 && gp.x < size.x && gp.y < size.y) {
                uint idx = uint(gp.y) * uint(size.x) + uint(gp.x);
                n = readResNormal(idx, readPongA);
                d = readResDepth (idx, readPongA);
            }
            sND[i] = vec4(n, d);
        }
        barrier();
    }

    if (px.x >= size.x || px.y >= size.y) return;

    // Sky pass-through.
    if (imageLoad(albedoImage, px).a < 0.5) {
        imageStore(outImage, px, imageLoad(inImage, px));
        return;
    }

    const uint pixIdx = uint(px.y) * uint(size.x) + uint(px.x);

    vec3  selfN;
    float selfD;
    if (useSharedMem) {
        ivec2 lp = ivec2(gl_LocalInvocationID.xy) + ivec2(2);
        vec4  s  = sND[lp.y * TILE_DIM + lp.x];
        selfN = s.xyz;
        selfD = s.w;
    } else {
        selfN = readResNormal(pixIdx, readPongA);
        selfD = readResDepth (pixIdx, readPongA);
    }

    const vec4  selfRGBA = imageLoad(inImage, px);
    const vec3  selfC = selfRGBA.rgb;
    const float selfL = dot(selfC, vec3(0.299, 0.587, 0.114));
    const float selfV = selfRGBA.a;
    // Chromaticity edge stop — ReSTIR DI's per-pixel point-light pick
    // makes hue high-frequency, so without this neighbors at the same
    // brightness but different hue average to grey.
    const vec3 selfChrom = selfC / max(selfL, 0.01);

    const float sigmaL = clamp(sqrt(max(selfV, 1e-6)) * 4.0 + 0.08, 0.08, 0.2);

    // 5x5 B3-spline (1,4,6,4,1)/16 outer product. Reach extended by stride.
    const float kB3[5] = float[5](1.0/16.0, 4.0/16.0, 6.0/16.0, 4.0/16.0, 1.0/16.0);

    vec3  sumC = vec3(0.0);
    float sumV = 0.0;
    float wsum = 0.0;
    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            ivec2 npx = px + ivec2(dx, dy) * pc.stride;
            if (npx.x < 0 || npx.y < 0 || npx.x >= size.x || npx.y >= size.y) continue;

            vec3  nN;
            float nD;
            if (useSharedMem) {
                ivec2 lp = ivec2(gl_LocalInvocationID.xy) + ivec2(2) + ivec2(dx, dy);
                vec4  s  = sND[lp.y * TILE_DIM + lp.x];
                nN = s.xyz;
                nD = s.w;
            } else {
                uint nIdx = uint(npx.y) * uint(size.x) + uint(npx.x);
                nN = readResNormal(nIdx, readPongA);
                nD = readResDepth (nIdx, readPongA);
            }

            vec4  nRGBA = imageLoad(inImage, npx);
            vec3  nC   = nRGBA.rgb;
            float nL   = dot(nC, vec3(0.299, 0.587, 0.114));
            float nV   = nRGBA.a;

            float kernelW = kB3[dx + 2] * kB3[dy + 2];
            vec3  nChrom  = nC / max(nL, 0.01);
            float wN = pow(max(dot(selfN, nN), 0.0), 8.0);
            float wD = exp(-abs(selfD - nD) / max(selfD, 0.01) * 8.0);
            float wL = exp(-abs(selfL - nL) / sigmaL);
            float wC = exp(-length(selfChrom - nChrom) / 0.4);
            float w  = (dx == 0 && dy == 0) ? kernelW
                                            : (kernelW * wN * wD * wL * wC);

            sumC += w * nC;
            sumV += w * w * nV;
            wsum += w;
        }
    }

    vec3  filteredC = (wsum > 0.0) ? (sumC / wsum)        : selfC;
    float filteredV = (wsum > 0.0) ? (sumV / (wsum*wsum)) : selfV;
    imageStore(outImage, px, vec4(filteredC, filteredV));
}
