#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0, rgba8)    uniform image2D outImage;
layout(set = 0, binding = 1) uniform accelerationStructureEXT topLevelAS;

layout(set = 0, binding = 2) uniform CameraUBO {
    vec4 eye_aspect;
    vec4 forward_fovTan;
    vec4 right_pad;
    vec4 up_pad;
    vec4 misc;
    vec4 prev_eye_aspect;
    vec4 prev_forward_fovTan;
    vec4 prev_right_pad;
    vec4 prev_up_pad;
} cam;

layout(set = 0, binding = 13) buffer Reservoirs0 { int d[]; } resA;
layout(set = 0, binding = 14) buffer Reservoirs1 { int d[]; } resB;

layout(set = 0, binding = 15, rgba16f) uniform image2D historyImage;
layout(set = 0, binding = 16, rgba8)   uniform image2D albedoImage;

layout(location = 0) rayPayloadEXT vec3 payloadColor;

vec3 readResNormal(uint pixIdx, bool fromA) {
    uint b = pixIdx * 12u;
    if (fromA)
        return vec3(intBitsToFloat(resA.d[b+4]),
                    intBitsToFloat(resA.d[b+5]),
                    intBitsToFloat(resA.d[b+6]));
    return vec3(intBitsToFloat(resB.d[b+4]),
                intBitsToFloat(resB.d[b+5]),
                intBitsToFloat(resB.d[b+6]));
}
float readResDepth(uint pixIdx, bool fromA) {
    uint b = pixIdx * 12u;
    return intBitsToFloat(fromA ? resA.d[b+7] : resB.d[b+7]);
}
vec3 readResHitWorld(uint pixIdx, bool fromA) {
    uint b = pixIdx * 12u;
    if (fromA)
        return vec3(intBitsToFloat(resA.d[b+8]),
                    intBitsToFloat(resA.d[b+9]),
                    intBitsToFloat(resA.d[b+10]));
    return vec3(intBitsToFloat(resB.d[b+8]),
                intBitsToFloat(resB.d[b+9]),
                intBitsToFloat(resB.d[b+10]));
}

void main()
{
    const ivec2 launchID   = ivec2(gl_LaunchIDEXT.xy);
    const ivec2 launchSize = ivec2(gl_LaunchSizeEXT.xy);
    const ivec2 px         = launchID;

    const vec2 pixelCenter = vec2(launchID) + vec2(0.5);
    const vec2 inUV        = pixelCenter / vec2(launchSize);
    vec2       ndc         = inUV * 2.0 - 1.0;
    ndc.y = -ndc.y;

    const vec3  eye    = cam.eye_aspect.xyz;
    const float aspect = cam.eye_aspect.w;
    const float fovTan = cam.forward_fovTan.w;

    const vec3 dir = normalize(cam.forward_fovTan.xyz
                               + ndc.x * fovTan * aspect * cam.right_pad.xyz
                               + ndc.y * fovTan          * cam.up_pad.xyz);

    payloadColor = vec3(0.0);
    traceRayEXT(topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF,
                0, 0, 0,
                eye, 0.001, dir, 10000.0, 0);

    payloadColor = min(payloadColor, vec3(4.0));

    const ivec2 px2 = launchID;
    vec4 albedoRGBA = imageLoad(albedoImage, px2);
    if (albedoRGBA.a < 0.5) {
        // Sky pixel — closesthit didn't fire so reservoir / TAA reprojection
        // would use stale hit data. Write sky color straight through.
        vec3 ldrSky = payloadColor / (payloadColor + 1.0);
        imageStore(outImage,     px2, vec4(ldrSky, 1.0));
        imageStore(historyImage, px2, vec4(payloadColor, 1.0));
        return;
    }

    const uint pixIdx = uint(launchID.y) * uint(launchSize.x) + uint(launchID.x);
    const uint frameId = floatBitsToUint(cam.misc.x) & 0x3FFFFFFFu;
    const bool readA   = (frameId & 1u) == 0u;

    // Need this frame's hit data (closesthit just wrote PONG[self_pixIdx]).
    // PING side has frame N-1's data — used for guidance and reprojection
    // surface check.
    const vec3  selfN  = readResNormal  (pixIdx, readA);
    const float selfD  = readResDepth   (pixIdx, readA);
    const vec3  hitW   = eye + dir * selfD;   // approximate hit world from prev-frame depth

    // ---- Motion-vector reprojection through prev-frame camera ----
    vec3 reprojColor = vec3(0.0);
    bool historyValid = false;
    {
        const vec3  pe = cam.prev_eye_aspect.xyz;
        const float pa = cam.prev_eye_aspect.w;
        const vec3  pf = cam.prev_forward_fovTan.xyz;
        const float pt = cam.prev_forward_fovTan.w;
        const vec3  pr = cam.prev_right_pad.xyz;
        const vec3  pu = cam.prev_up_pad.xyz;

        // Use the reservoir's stored hitWorld for accurate reprojection
        // (selfD is along curr ray, but reservoir's hitWorld is a real point).
        const vec3 storedHitW = readResHitWorld(pixIdx, readA);
        const vec3 toHit = storedHitW - pe;
        const float vz   = dot(toHit, pf);
        if (vz > 0.0) {
            const float vx = dot(toHit, pr);
            const float vy = dot(toHit, pu);
            const float ndcX = vx / (vz * pt * pa);
            const float ndcY = vy / (vz * pt);
            const vec2 prevUV = vec2(ndcX * 0.5 + 0.5, -ndcY * 0.5 + 0.5);
            if (prevUV.x >= 0.0 && prevUV.x <= 1.0 && prevUV.y >= 0.0 && prevUV.y <= 1.0) {
                const ivec2 prevPx = ivec2(prevUV * vec2(launchSize));
                if (prevPx.x >= 0 && prevPx.y >= 0 &&
                    prevPx.x < launchSize.x && prevPx.y < launchSize.y) {
                    // Surface-match check at reprojected pixel: is the surface
                    // showing there last frame the same as our current hit?
                    const uint  prevIdx = uint(prevPx.y) * uint(launchSize.x) + uint(prevPx.x);
                    const vec3  pN = readResNormal(prevIdx, readA);
                    const vec3  pHit = readResHitWorld(prevIdx, readA);
                    if (dot(pN, selfN) > 0.95 &&
                        length(pHit - storedHitW) < max(length(storedHitW - pe), 1.0) * 0.05)
                    {
                        reprojColor  = imageLoad(historyImage, prevPx).rgb;
                        historyValid = true;
                    }
                }
            }
        }
    }

    const float alpha = historyValid ? 0.1 : 1.0;
    vec3 result = mix(reprojColor, payloadColor, alpha);
    imageStore(historyImage, px, vec4(result, 1.0));

    // Edge-aware 5x5 spatial filter (normal + depth + luminance gates).
    // Luminance gate keeps shadow boundaries crisp on the same surface.
    vec3  selfC = imageLoad(historyImage, px).rgb;
    float selfL = dot(selfC, vec3(0.299, 0.587, 0.114));
    vec3  sum   = vec3(0.0);
    float wsum  = 0.0;
    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            ivec2 npx = px + ivec2(dx, dy);
            if (npx.x < 0 || npx.y < 0 || npx.x >= launchSize.x || npx.y >= launchSize.y) continue;
            uint  nIdx = uint(npx.y) * uint(launchSize.x) + uint(npx.x);
            vec3  nN   = readResNormal(nIdx, readA);
            float nD   = readResDepth (nIdx, readA);
            vec3  nC   = imageLoad(historyImage, npx).rgb;
            float nL   = dot(nC, vec3(0.299, 0.587, 0.114));

            float wN = pow(max(dot(selfN, nN), 0.0), 8.0);
            float wD = exp(-abs(selfD - nD) / max(selfD, 0.01) * 8.0);
            float wL = exp(-abs(selfL - nL) * 4.0);
            float w  = (dx == 0 && dy == 0) ? 1.0 : (wN * wD * wL);

            sum  += w * nC;
            wsum += w;
        }
    }
    vec3 filteredLight = (wsum > 0.0) ? (sum / wsum) : result;

    // Albedo demodulation: multiply lighting by per-pixel material color
    // AFTER spatial filtering so texture detail isn't blurred.
    vec3 albedo = imageLoad(albedoImage, px).rgb;
    vec3 final  = filteredLight * albedo;

    vec3 ldr = final / (final + 1.0);
    imageStore(outImage, px, vec4(ldr, 1.0));
}
