#version 460
#extension GL_EXT_ray_tracing : require

// Output storage image — raygen writes one color per pixel.
layout(set = 0, binding = 0, rgba8) uniform image2D outImage;
// Top-level acceleration structure to trace into.
layout(set = 0, binding = 1) uniform accelerationStructureEXT topLevelAS;
// Camera UBO (placeholder — actual layout matches engine's CameraConstants).
layout(set = 0, binding = 2) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
} cam;

// Payload returned from closest-hit / miss.
layout(location = 0) rayPayloadEXT vec3 payloadColor;

void main()
{
    // Pixel coord in [0, w) × [0, h).
    const vec2 pixelCenter = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
    const vec2 inUV        = pixelCenter / vec2(gl_LaunchSizeEXT.xy);
    const vec2 d           = inUV * 2.0 - 1.0;

    // Reconstruct world-space ray from camera matrices.
    vec4 origin    = cam.viewInverse * vec4(0.0, 0.0, 0.0, 1.0);
    vec4 target    = cam.projInverse * vec4(d.x, d.y, 1.0, 1.0);
    vec4 direction = cam.viewInverse * vec4(normalize(target.xyz), 0.0);

    payloadColor = vec3(0.0);

    traceRayEXT(
        topLevelAS,         // TLAS
        gl_RayFlagsOpaqueEXT,
        0xFF,               // cull mask
        0, 0, 0,             // sbt offset / stride / miss index
        origin.xyz,
        0.001,              // tmin
        direction.xyz,
        10000.0,            // tmax
        0                    // payload location
    );

    imageStore(outImage, ivec2(gl_LaunchIDEXT.xy), vec4(payloadColor, 1.0));
}
