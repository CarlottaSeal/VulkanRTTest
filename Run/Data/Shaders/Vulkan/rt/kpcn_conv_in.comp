#version 450
// KPCN layer 1: features (log1p(light), albedo) -> 32 channels, 3x3 conv,
// zero padding, ReLU.
// Weights: [tap 9][in 6][out 32] floats, then 32 biases (see export_kpcn.py).
// Activations: 32 halves per pixel, packed as 4 uvec4.
//
// Same 32x16 tile / 2x2 px per invocation layout as kpcn_conv_mid: the 6
// features of the tile + 1 px halo are computed once into shared memory
// (log1p once per pixel instead of once per tap), and every weight vec4 loaded
// feeds 4 pixels.

#define TW 32
#define TH 16
#define SW (TW + 2)
#define SH (TH + 2)

layout(local_size_x = 16, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D lightImage;
layout(set = 0, binding = 1, rgba8)   uniform readonly image2D albedoImage;
layout(set = 0, binding = 4) writeonly buffer ActOut { uvec4 actOut[]; };
layout(set = 0, binding = 5) readonly  buffer Weights { vec4 w[]; };

layout(push_constant) uniform PC { ivec2 size; int wOff; int bOff; } pc;

shared vec3 featL[SH][SW];
shared vec3 featA[SH][SW];

void main()
{
    const ivec2 origin = ivec2(gl_WorkGroupID.xy) * ivec2(TW, TH);

    for (uint i = gl_LocalInvocationIndex; i < SH * SW; i += 128u)
    {
        ivec2 q = origin + ivec2(i % SW, i / SW) - 1;
        bool inside = all(greaterThanEqual(q, ivec2(0))) && all(lessThan(q, pc.size));
        featL[i / SW][i % SW] = inside ? log(1.0 + max(imageLoad(lightImage, q).rgb, vec3(0.0))) : vec3(0.0);
        featA[i / SW][i % SW] = inside ? imageLoad(albedoImage, q).rgb : vec3(0.0);
    }
    barrier();

    const ivec2 t = ivec2(gl_LocalInvocationID.xy);
    vec4 acc[4][8];  // [pixel][out vec4]
    for (int o = 0; o < 8; ++o)
    {
        vec4 b = w[pc.bOff + o];
        for (int px = 0; px < 4; ++px) acc[px][o] = b;
    }

    for (int ky = 0; ky < 3; ++ky)
    for (int kx = 0; kx < 3; ++kx)
    {
        int tap = ky * 3 + kx;
        float f[4][6];
        for (int px = 0; px < 4; ++px)
        {
            int y = t.y + (px >> 1) * 8 + ky, x = t.x + (px & 1) * 16 + kx;
            vec3 l = featL[y][x], a = featA[y][x];
            f[px][0] = l.r; f[px][1] = l.g; f[px][2] = l.b;
            f[px][3] = a.r; f[px][4] = a.g; f[px][5] = a.b;
        }
        for (int i = 0; i < 6; ++i)
        {
            int wb = pc.wOff + (tap * 6 + i) * 8;
            for (int o = 0; o < 8; ++o)
            {
                vec4 wv = w[wb + o];
                for (int px = 0; px < 4; ++px) acc[px][o] += f[px][i] * wv;
            }
        }
    }

    for (int px = 0; px < 4; ++px)
    {
        ivec2 p = origin + t + ivec2((px & 1) * 16, (px >> 1) * 8);
        if (p.x >= pc.size.x || p.y >= pc.size.y) continue;
        int base = (p.y * pc.size.x + p.x) * 4;
        for (int c = 0; c < 4; ++c)
        {
            vec4 a = max(acc[px][2 * c], 0.0), b = max(acc[px][2 * c + 1], 0.0);
            actOut[base + c] = uvec4(packHalf2x16(a.xy), packHalf2x16(a.zw),
                                     packHalf2x16(b.xy), packHalf2x16(b.zw));
        }
    }
}
