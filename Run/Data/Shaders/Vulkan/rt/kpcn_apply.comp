#version 450
// KPCN last layer: 1x1 conv 32 -> 25 logits, softmax, then the 5x5 weighted
// sum of the noisy light (edge-clamped, like F.pad replicate). Writes the
// denoised demodulated light (rgb halves) for kpcn_temporal.
// Weights: [in 32][out 28] floats (25 used), then 28 biases.

layout(local_size_x = 16, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D lightImage;
layout(set = 0, binding = 3) readonly  buffer ActIn { uvec4 actIn[]; };
layout(set = 0, binding = 4) writeonly buffer Denoised { uvec2 denoised[]; };
layout(set = 0, binding = 5) readonly  buffer Weights { vec4 w[]; };

layout(push_constant) uniform PC { ivec2 size; int wOff; int bOff; } pc;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.size.x || p.y >= pc.size.y) return;

    vec4 acc[7];
    for (int o = 0; o < 7; ++o) acc[o] = w[pc.bOff + o];

    int src = (p.y * pc.size.x + p.x) * 4;
    for (int c = 0; c < 4; ++c)
    {
        uvec4 pk = actIn[src + c];
        vec2 h[4] = vec2[4](unpackHalf2x16(pk.x), unpackHalf2x16(pk.y),
                            unpackHalf2x16(pk.z), unpackHalf2x16(pk.w));
        for (int j = 0; j < 8; ++j)
        {
            float v = h[j >> 1][j & 1];
            int wb = pc.wOff + (c * 8 + j) * 7;
            for (int o = 0; o < 7; ++o) acc[o] += v * w[wb + o];
        }
    }

    float logit[25];
    float mx = -1e30;
    for (int k = 0; k < 25; ++k)
    {
        logit[k] = acc[k >> 2][k & 3];
        mx = max(mx, logit[k]);
    }
    float sum = 0.0;
    vec3 light = vec3(0.0);
    for (int k = 0; k < 25; ++k)
    {
        float e = exp(logit[k] - mx);
        sum += e;
        ivec2 q = clamp(p + ivec2(k % 5 - 2, k / 5 - 2), ivec2(0), pc.size - 1);
        light += e * imageLoad(lightImage, q).rgb;
    }
    light = max(light / sum, vec3(0.0));
    denoised[p.y * pc.size.x + p.x] = uvec2(packHalf2x16(light.rg), packHalf2x16(vec2(light.b, 0.0)));
}
